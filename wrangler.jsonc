{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ephemeral-page",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "RUNTIME_DRIVER": "local",
    "COMPOSER": "fixture",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPRESSIONS",
        "class_name": "ExpressionObject"
      },
      {
        "name": "CREATE_RATE_LIMITER",
        "class_name": "CreateRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExpressionObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CreateRateLimiter"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPRESSION_ASSETS",
      "bucket_name": "ephemeral-page-expression-assets"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "ephemeral-page",
      "routes": [
        {
          "pattern": "ephemeral.page",
          "custom_domain": true
        },
        {
          "pattern": "www.ephemeral.page",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://ephemeral.page",
        "RUNTIME_DRIVER": "durable-object",
        "COMPOSER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EXPRESSIONS",
            "class_name": "ExpressionObject"
          },
          {
            "name": "CREATE_RATE_LIMITER",
            "class_name": "CreateRateLimiter"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "EXPRESSION_ASSETS",
          "bucket_name": "ephemeral-page-expression-assets"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
